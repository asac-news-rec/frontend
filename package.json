{
  "name": "newsroom-feedback-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node .local/dev-server.js",
    "dev": "npm start",
    "check": "tsc --noEmit && tsc -p tsconfig.browser.json --noEmit && node scripts/check.mjs",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "build:local": "tsc && npm run build",
    "prestart": "npm run build:local",
    "pretest": "npm run build:local"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.9.3"
  }
}
